# PostgreSQL connection string. In production this is your Neon database URL
# (Vercel + Neon integration sets it for you). For local development, point it
# at a Neon branch or a local Postgres instance.
#   postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/dealership?schema=public"

# Secret used to sign admin session JWTs. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-32-random-bytes-base64"

# --- Email notifications for new leads (optional) ---
# Sign up at https://resend.com (free plan), create an API key, and paste it
# here. Leave blank and lead notifications are simply skipped.
RESEND_API_KEY=""
# The "From" address on notification emails. Until you verify your own domain
# in Resend, use "onboarding@resend.dev" (it can only deliver to the address
# that owns your Resend account). After verifying a domain, use something like
# "Mr. Cash Auto Sales <leads@yourdomain.com>".
EMAIL_FROM="onboarding@resend.dev"
