DATABASE_URL="file:./prisma/dev.db"
SESSION_SECRET="replace-with-output-of-openssl-rand--base64-32"

# --- Email notifications for new leads (optional) ---
# Sign up at https://resend.com (free plan), create an API key, and paste it
# here. Leave blank and lead notifications are simply skipped.
RESEND_API_KEY=""
# The "From" address on notification emails. Until you verify your own domain
# in Resend, use "onboarding@resend.dev" (it can only deliver to the address
# that owns your Resend account). After verifying a domain, use something like
# "Mr. Cash Auto Sales <leads@yourdomain.com>".
EMAIL_FROM="onboarding@resend.dev"
